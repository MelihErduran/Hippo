  "schedule": {
    "dayStart": "07:00",
    "dayEnd": "23:00",
    "blocks": [
      { "days": ["mon", "wed", "fri"], "start": "09:00", "end": "10:00", "label": "Focus block" },
      { "days": ["tue", "thu"], "start": "14:00", "end": "15:00", "label": "Meeting" }
    ]
  }
}
